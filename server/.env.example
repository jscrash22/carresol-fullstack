# server/.env.example — plantilla con VALORES FALSOS de ejemplo.
# Copia este archivo como server/.env y reemplaza cada valor por el real.
# server/.env está ignorado por git y JAMÁS se versiona ni se comparte.
#
# En Windows/PowerShell:
#   Copy-Item .env.example .env
#   notepad .env

# Entorno de ejecución: development | production (los tokens de recuperación
# de contraseña solo se devuelven en la respuesta cuando NO es production)
NODE_ENV=development

# Puerto del backend (el frontend espera 3000 por defecto)
PORT=3000

# Cadena de conexión a PostgreSQL. Ejemplos:
#  - Docker (docker-compose.yml del repo):     postgresql://carresol:CAMBIA_ESTA_CLAVE@localhost:5432/carresol?schema=public
#  - PostgreSQL local instalado en el equipo:  postgresql://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/carresol?schema=public
#  - Supabase (pooler de sesiones):            postgresql://postgres.CAMBIA:CAMBIA_ESTA_CLAVE@aws-0-CAMBIA.pooler.supabase.com:5432/postgres?schema=public
DATABASE_URL=postgresql://carresol:CAMBIA_ESTA_CLAVE@localhost:5432/carresol?schema=public

# Solo para Supabase: cadena DIRECTA (sin pooler) que usan las migraciones.
# Déjala igual a DATABASE_URL si no usas Supabase.
DIRECT_URL=postgresql://carresol:CAMBIA_ESTA_CLAVE@localhost:5432/carresol?schema=public

# Clave para firmar los JWT: genera la tuya con un generador de secretos
# aleatorios (mínimo 32 caracteres). NUNCA uses esta de ejemplo.
JWT_SECRET=CAMBIA_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES

# Expiración de los tokens de sesión (formato jsonwebtoken)
JWT_EXPIRES_IN=2h

# Orígenes permitidos para CORS (el frontend estático se sirve aquí).
# Separa varios orígenes con coma, sin espacios. NUNCA uses "*".
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# HTTPS del backend: true solo si sirves la API detrás de TLS con certificados
# en server/certs/ (desarrollo local: false)
HTTPS=false

# Costo de bcrypt para hashear contraseñas (12 está bien para desarrollo;
# subirlo lo hace más lento y más seguro)
BCRYPT_ROUNDS=12

# Contraseña del contenedor PostgreSQL si usas docker-compose.yml
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE

# Credenciales que crea el seed (npm run db:seed) para probar la app.
# Genera contraseñas fuertes; en el proyecto real están solo en server/.env
# y se documentan en docs/REPORTE_FINAL.md.
SEED_ADMIN_NOMBRE=Admin Carresol
SEED_ADMIN_EMAIL=admin@carresol.com
SEED_ADMIN_PASSWORD=CambiaEstaClave1
SEED_USER_NOMBRE=Cliente Prueba
SEED_USER_EMAIL=cliente@carresol.com
SEED_USER_PASSWORD=CambiaEstaClave2
