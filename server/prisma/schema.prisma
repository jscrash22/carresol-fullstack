// ============================================================
// Carresol — Schema Prisma (PostgreSQL) — Reto 2 modelo ER real
// Fuente: docs/diagrama_er_joyeria.pdf + transcripción §4/§5 del prompt
// (la transcripción tiene prioridad; ver docs/DECISIONES.md).
//
// Convenciones:
//  • Tablas/columnas en snake_case en la BD (@@map/@map); camelCase en Prisma.
//  • bigint ids (BigInt en Prisma) → convertidos a Number en server/models.
//  • numeric con precisión explícita @db.Decimal(12,2) → Number al responder.
//  • timestamptz en todas las fechas-hora; enums nativos de PostgreSQL.
//  • numero_pedido / numero_compra: secuencia propia (numero_pedido_seq /
//    numero_compra_seq), independiente del id PK.
//  • Restricciones CHECK extra (stock >= 0, cantidad > 0, precios >= 0,
//    char_length(clave_acceso) = 49) se agregan editando la migración
//    inicial (ver prisma/migrations/.../migration.sql).
//  • Para Supabase: DATABASE_URL (pooler 6543) y DIRECT_URL (5432) en .env;
//    activar RLS con docs/legacy/rls_supabase.sql (ver docs/BLOQUEOS.md).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums (nativos de PostgreSQL) ----------
enum EstadoPedido {
  pendiente
  pagado
  preparando
  enviado
  entregado
  cancelado
}

enum MetodoPago {
  tarjeta
  transferencia
  deposito
  contra_entrega
}

enum EstadoPago {
  pendiente
  aprobado
  rechazado
  reembolsado
}

enum TipoMedida {
  unica
  talla
  largo
  diametro
}

enum CanalPreferido {
  email
  telefono
  whatsapp
}

enum TipoFactura {
  factura
  nota_credito
}

enum TipoIdentificacion {
  cedula
  ruc
  pasaporte
  consumidor_final
}

enum EstadoFactura {
  emitida
  anulada
}

enum EstadoEnvio {
  pendiente
  preparando
  en_transito
  entregado
  devuelto
}

enum AccionAuditoria {
  INSERT
  UPDATE
  DELETE
}

enum EstadoCompra {
  borrador
  ordenada
  recibida
  cancelada
}

enum TipoMovimiento {
  venta
  compra
  ajuste
  devolucion
}

// ============================================================
// 4.1 Usuarios y acceso
// ============================================================

model Rol {
  id          Int       @id @default(autoincrement()) @db.SmallInt
  nombre      String    @unique
  descripcion String?
  usuarios    Usuario[]

  @@map("roles")
}

model Usuario {
  id              BigInt    @id @default(autoincrement())
  rolId           Int       @map("rol_id") @db.SmallInt
  nombre          String
  telefono        String?
  email           String    @unique
  passwordHash    String    @map("password_hash")
  cedula          String?
  emailVerificado Boolean   @default(false) @map("email_verificado")
  activo          Boolean   @default(true)
  ultimoLogin     DateTime? @map("ultimo_login") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  rol                 Rol                     @relation(fields: [rolId], references: [id])
  direcciones         Direccion[]
  carrito             Carrito?
  favoritos           Favorito[]
  pedidos             Pedido[]
  cambiosEstadoPedido PedidoHistorialEstado[]
  resetTokens         PasswordResetToken[]
  mensajes            MensajeContacto[]       @relation("MensajesDeUsuario")
  mensajesLeidos      MensajeContacto[]       @relation("MensajesLeidosPor")
  movimientos         MovimientoInventario[]
  auditorias          Auditoria[]
  compras             Compra[]

  @@index([rolId])
  @@map("usuarios")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement())
  usuarioId BigInt    @map("usuario_id")
  tokenHash String    @unique @map("token_hash")
  expiraAt  DateTime  @map("expira_at") @db.Timestamptz(3)
  usadoAt   DateTime? @map("usado_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("password_reset_tokens")
}

model Direccion {
  id               BigInt   @id @default(autoincrement())
  usuarioId        BigInt   @map("usuario_id")
  alias            String
  destinatario     String
  telefono         String
  provincia        String
  ciudad           String
  callePrincipal   String   @map("calle_principal")
  calleSecundaria  String?  @map("calle_secundaria")
  numeracion       String
  referencia       String?
  codigoPostal     String?  @map("codigo_postal")
  esPredeterminada Boolean  @default(false) @map("es_predeterminada")
  activa           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pedidos Pedido[]

  @@index([usuarioId])
  @@map("direcciones")
}

// ============================================================
// 4.2 Catálogo
// ============================================================

model Categoria {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  slug        String  @unique
  descripcion String?
  orden       Int     @db.SmallInt
  activa      Boolean @default(true)

  materiales         Material[]
  productos          Producto[]
  productoMateriales ProductoMaterial[]

  @@map("categorias")
}

model Material {
  id          Int     @id @default(autoincrement())
  categoriaId Int     @map("categoria_id")
  nombre      String  @unique
  activo      Boolean @default(true)

  categoria          Categoria          @relation(fields: [categoriaId], references: [id])
  productoMateriales ProductoMaterial[]
  imagenes           ProductoImagen[]
  variantes          Variante[]

  @@index([categoriaId])
  @@map("materiales")
}

model Producto {
  id          BigInt   @id @default(autoincrement())
  categoriaId Int      @map("categoria_id")
  nombre      String
  slug        String   @unique
  descripcion String?
  precioBase  Decimal  @map("precio_base") @db.Decimal(12, 2)
  activo      Boolean  @default(true)
  destacado   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  categoria  Categoria          @relation(fields: [categoriaId], references: [id])
  materiales ProductoMaterial[]
  imagenes   ProductoImagen[]
  variantes  Variante[]
  favoritos  Favorito[]

  @@index([categoriaId])
  @@map("productos")
}

model ProductoMaterial {
  productoId  BigInt   @map("producto_id")
  materialId  Int      @map("material_id")
  categoriaId Int      @map("categoria_id")
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  producto  Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  material  Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id])

  @@id([productoId, materialId])
  @@index([categoriaId])
  @@map("producto_materiales")
}

model ProductoImagen {
  id          BigInt   @id @default(autoincrement())
  productoId  BigInt   @map("producto_id")
  materialId  Int?     @map("material_id")
  url         String
  altText     String?  @map("alt_text")
  orden       Int      @default(0) @db.SmallInt
  esPrincipal Boolean  @default(false) @map("es_principal")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  producto Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  material Material? @relation(fields: [materialId], references: [id])

  @@index([productoId])
  @@index([materialId])
  @@map("producto_imagenes")
}

model Variante {
  id          BigInt     @id @default(autoincrement())
  productoId  BigInt     @map("producto_id")
  materialId  Int        @map("material_id")
  sku         String     @unique
  tipoMedida  TipoMedida @map("tipo_medida")
  medida      String
  precio      Decimal    @db.Decimal(12, 2)
  stock       Int        @default(0)
  stockMinimo Int        @default(3) @map("stock_minimo")
  pesoGramos  Decimal?   @map("peso_gramos") @db.Decimal(10, 2)
  costo       Decimal?   @db.Decimal(12, 2)
  activo      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  producto     Producto               @relation(fields: [productoId], references: [id])
  material     Material               @relation(fields: [materialId], references: [id])
  carritoItems CarritoItem[]
  pedidoItems  PedidoItem[]
  compraItems  CompraItem[]
  movimientos  MovimientoInventario[]

  @@index([productoId])
  @@index([materialId])
  @@map("variantes")
}

// ============================================================
// 4.3 Carrito y favoritos
// ============================================================

model Carrito {
  id        BigInt   @id @default(autoincrement())
  usuarioId BigInt   @unique @map("usuario_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  usuario Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  items   CarritoItem[]

  @@map("carritos")
}

model CarritoItem {
  id             BigInt   @id @default(autoincrement())
  carritoId      BigInt   @map("carrito_id")
  varianteId     BigInt   @map("variante_id")
  cantidad       Int
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  carrito  Carrito  @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  variante Variante @relation(fields: [varianteId], references: [id], onDelete: Cascade)

  @@unique([carritoId, varianteId])
  @@index([varianteId])
  @@map("carrito_items")
}

model Favorito {
  id         BigInt   @id @default(autoincrement())
  usuarioId  BigInt   @map("usuario_id")
  productoId BigInt   @map("producto_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, productoId])
  @@index([productoId])
  @@map("favoritos")
}

// ============================================================
// 4.4 Pedidos y pagos
// ============================================================

model Pedido {
  id            BigInt       @id @default(autoincrement())
  numeroPedido  BigInt       @unique @default(autoincrement()) @map("numero_pedido")
  usuarioId     BigInt       @map("usuario_id")
  direccionId   BigInt?      @map("direccion_id")
  estado        EstadoPedido @default(pendiente)
  subtotal      Decimal      @db.Decimal(12, 2)
  costoEnvio    Decimal      @default(0) @map("costo_envio") @db.Decimal(12, 2)
  ivaPorcentaje Decimal      @map("iva_porcentaje") @db.Decimal(5, 2)
  ivaValor      Decimal      @map("iva_valor") @db.Decimal(12, 2)
  total         Decimal      @db.Decimal(12, 2)
  moneda        String       @default("USD") @db.Char(3)
  notas         String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  usuario   Usuario                 @relation(fields: [usuarioId], references: [id])
  direccion Direccion?              @relation(fields: [direccionId], references: [id], onDelete: SetNull)
  items     PedidoItem[]
  historial PedidoHistorialEstado[]
  pagos     Pago[]
  factura   Factura?
  envio     Envio?

  @@index([usuarioId])
  @@index([estado])
  @@map("pedidos")
}

model PedidoItem {
  id             BigInt  @id @default(autoincrement())
  pedidoId       BigInt  @map("pedido_id")
  varianteId     BigInt  @map("variante_id")
  sku            String
  nombreProducto String  @map("nombre_producto")
  material       String
  medida         String
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  variante Variante @relation(fields: [varianteId], references: [id])

  @@index([pedidoId])
  @@index([varianteId])
  @@map("pedido_items")
}

model PedidoHistorialEstado {
  id             BigInt        @id @default(autoincrement())
  pedidoId       BigInt        @map("pedido_id")
  estadoAnterior EstadoPedido? @map("estado_anterior")
  estadoNuevo    EstadoPedido  @map("estado_nuevo")
  usuarioId      BigInt?       @map("usuario_id")
  comentario     String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  pedido  Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([pedidoId])
  @@map("pedido_historial_estados")
}

model Pago {
  id                BigInt     @id @default(autoincrement())
  pedidoId          BigInt     @map("pedido_id")
  metodo            MetodoPago
  pasarela          String     @default("simulada")
  referenciaExterna String     @unique @map("referencia_externa")
  monto             Decimal    @db.Decimal(12, 2)
  moneda            String     @default("USD") @db.Char(3)
  estado            EstadoPago @default(pendiente)
  respuestaPasarela Json?      @map("respuesta_pasarela")
  fechaPago         DateTime?  @map("fecha_pago") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@map("pagos")
}

// ============================================================
// 4.5 Facturación y envío
// ============================================================

model PuntoEmision {
  establecimiento  String  @map("establecimiento") @db.Char(3)
  punto            String  @map("punto") @db.Char(3)
  ultimoSecuencial BigInt  @default(0) @map("ultimo_secuencial")
  activo           Boolean @default(true)

  facturas Factura[]

  @@id([establecimiento, punto])
  @@map("puntos_emision")
}

model Factura {
  id                 BigInt             @id @default(autoincrement())
  pedidoId           BigInt             @unique @map("pedido_id")
  establecimiento    String             @map("establecimiento") @db.Char(3)
  puntoEmision       String             @map("punto_emision") @db.Char(3)
  secuencial         BigInt             @map("secuencial")
  numero             String             @unique @map("numero")
  tipo               TipoFactura        @default(factura)
  tipoIdentificacion TipoIdentificacion @map("tipo_identificacion")
  identificacion     String             @map("identificacion")
  razonSocial        String             @map("razon_social")
  emailFacturacion   String             @map("email_facturacion")
  telefono           String?
  direccionFiscal    String?            @map("direccion_fiscal")
  subtotal           Decimal            @db.Decimal(12, 2)
  costoEnvio         Decimal            @default(0) @map("costo_envio") @db.Decimal(12, 2)
  ivaPorcentaje      Decimal            @map("iva_porcentaje") @db.Decimal(5, 2)
  ivaValor           Decimal            @map("iva_valor") @db.Decimal(12, 2)
  total              Decimal            @db.Decimal(12, 2)
  estado             EstadoFactura      @default(emitida)
  claveAcceso        String             @unique @map("clave_acceso")
  fechaEmision       DateTime           @default(now()) @map("fecha_emision") @db.Timestamptz(3)
  anuladaAt          DateTime?          @map("anulada_at") @db.Timestamptz(3)
  motivoAnulacion    String?            @map("motivo_anulacion")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  pedido Pedido       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  punto  PuntoEmision @relation(fields: [establecimiento, puntoEmision], references: [establecimiento, punto])

  @@index([pedidoId])
  @@map("facturas")
}

model Envio {
  id                BigInt      @id @default(autoincrement())
  pedidoId          BigInt      @unique @map("pedido_id")
  direccionSnapshot Json?       @map("direccion_snapshot")
  transportista     String?
  numeroGuia        String?     @map("numero_guia")
  estado            EstadoEnvio @default(pendiente)
  costo             Decimal     @default(0) @db.Decimal(12, 2)
  fechaDespacho     DateTime?   @map("fecha_despacho") @db.Timestamptz(3)
  fechaEstimada     DateTime?   @map("fecha_estimada") @db.Date
  fechaEntrega      DateTime?   @map("fecha_entrega") @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@map("envios")
}

// ============================================================
// 4.6 Soporte y sistema
// ============================================================

model MensajeContacto {
  id             BigInt         @id @default(autoincrement())
  usuarioId      BigInt?        @map("usuario_id")
  nombre         String
  email          String
  telefono       String?
  mensaje        String
  canalPreferido CanalPreferido @default(email) @map("canal_preferido")
  leido          Boolean        @default(false)
  leidoAt        DateTime?      @map("leido_at") @db.Timestamptz(3)
  leidoPor       BigInt?        @map("leido_por")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  usuario Usuario? @relation("MensajesDeUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  lector  Usuario? @relation("MensajesLeidosPor", fields: [leidoPor], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@map("mensajes_contacto")
}

model ParametroSistema {
  clave       String   @id
  valor       String
  descripcion String?
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("parametros_sistema")
}

model Auditoria {
  id              BigInt          @id @default(autoincrement())
  tabla           String
  registroId      String          @map("registro_id")
  accion          AccionAuditoria
  datosAnteriores Json?           @map("datos_anteriores")
  datosNuevos     Json?           @map("datos_nuevos")
  usuarioId       BigInt?         @map("usuario_id")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([tabla])
  @@index([usuarioId])
  @@map("auditoria")
}

// ============================================================
// 5. Módulo de compras (reposición de inventario a proveedores)
// ============================================================

model Proveedor {
  id        BigInt   @id @default(autoincrement())
  nombre    String
  ruc       String   @unique
  email     String?
  telefono  String?
  direccion String?
  contacto  String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  compras Compra[]

  @@map("proveedores")
}

model Compra {
  id                     BigInt       @id @default(autoincrement())
  numeroCompra           BigInt       @unique @default(autoincrement()) @map("numero_compra")
  proveedorId            BigInt       @map("proveedor_id")
  usuarioId              BigInt       @map("usuario_id")
  estado                 EstadoCompra @default(borrador)
  numeroFacturaProveedor String?      @map("numero_factura_proveedor")
  subtotal               Decimal      @db.Decimal(12, 2)
  ivaPorcentaje          Decimal      @map("iva_porcentaje") @db.Decimal(5, 2)
  ivaValor               Decimal      @map("iva_valor") @db.Decimal(12, 2)
  total                  Decimal      @db.Decimal(12, 2)
  moneda                 String       @default("USD") @db.Char(3)
  fechaCompra            DateTime?    @map("fecha_compra") @db.Timestamptz(3)
  fechaRecepcion         DateTime?    @map("fecha_recepcion") @db.Timestamptz(3)
  notas                  String?
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  proveedor Proveedor    @relation(fields: [proveedorId], references: [id])
  usuario   Usuario      @relation(fields: [usuarioId], references: [id])
  items     CompraItem[]

  @@index([proveedorId])
  @@index([usuarioId])
  @@map("compras")
}

model CompraItem {
  id             BigInt  @id @default(autoincrement())
  compraId       BigInt  @map("compra_id")
  varianteId     BigInt  @map("variante_id")
  sku            String
  nombreProducto String  @map("nombre_producto")
  cantidad       Int
  costoUnitario  Decimal @map("costo_unitario") @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  compra   Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  variante Variante @relation(fields: [varianteId], references: [id])

  @@index([compraId])
  @@index([varianteId])
  @@map("compra_items")
}

model MovimientoInventario {
  id             BigInt         @id @default(autoincrement())
  varianteId     BigInt         @map("variante_id")
  tipo           TipoMovimiento
  cantidad       Int
  referenciaTipo String?        @map("referencia_tipo")
  referenciaId   String?        @map("referencia_id")
  usuarioId      BigInt?        @map("usuario_id")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  variante Variante @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  usuario  Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([varianteId])
  @@index([tipo])
  @@map("movimientos_inventario")
}
